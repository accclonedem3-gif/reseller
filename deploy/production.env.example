NODE_ENV=production

API_PORT=3000
# Defense in depth: only the local nginx reverse proxy may reach Node directly.
API_HOST=127.0.0.1

# Distributed NestJS rate limit (stored in Redis).
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_BLOCK_MS=60000

DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@localhost:5432/reseller_platform?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=reseller_platform
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_LONG_RANDOM_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
APP_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_OR_LONG_STABLE_SECRET
INTERNAL_API_TOKEN=CHANGE_ME_LONG_RANDOM_INTERNAL_TOKEN

APP_PUBLIC_URL=https://api.altivoxai.com
WEB_PUBLIC_URL=https://altivoxai.com
CORS_ORIGIN=https://altivoxai.com
PUBLIC_UPLOAD_BASE_URL=https://api.altivoxai.com/uploads
VITE_API_URL=https://api.altivoxai.com/api/v1
PASSWORD_RESET_TTL_MINUTES=30
RESEND_API_KEY=
MAIL_FROM=Altivox AI <no-reply@altivoxai.com>

PAYMENT_MODE=payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# PayPal checkout credentials are configured per shop in the dashboard.
PAYPAL_VND_RATE=26000

# USDT Jetton on TON (automatic incoming-transfer scanner)
TONCENTER_API_BASE_URL=https://toncenter.com/api/v3
TONCENTER_API_KEY=
# Official mainnet USDT Jetton master. Do not replace with a user wallet address.
TON_USDT_MASTER_ADDRESS=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
TON_USDT_DECIMALS=6
TON_PAYMENT_SCAN_INTERVAL_MS=30000
# Optional; unrelated to normal shop-bot orders. Only used for seller deposits/tier purchases.
PLATFORM_DEPOSIT_SHOP_ID=

DEFAULT_PROVIDER_BASE_URL=https://canboso.com
DEFAULT_PROVIDER_NAME=canboso
DEFAULT_CURRENCY=VND

SEED_SUPER_ADMIN_EMAIL=thaidem57
SEED_SUPER_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_DEMO_DATA=false

MOCK_PROVIDER_ENABLED=false
MOCK_TELEGRAM_MODE=false

CATALOG_SYNC_INTERVAL_MS=60000
CATALOG_SCHEDULER_TICK_MS=5000
CATALOG_SHOPS_REFRESH_MS=60000
CATALOG_SYNC_CONCURRENCY=12
