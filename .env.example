NODE_ENV=development

API_PORT=3000
# Development may bind all interfaces. Production defaults to 127.0.0.1 and rejects public binds.
API_HOST=0.0.0.0

API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_BLOCK_MS=60000
WEB_PORT=5173
WORKER_PORT=3200

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reseller_platform?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reseller_platform
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
APP_ENCRYPTION_KEY=change-me-32-byte-key
INTERNAL_API_TOKEN=change-me-internal-api-token

APP_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1
PASSWORD_RESET_TTL_MINUTES=30
RESEND_API_KEY=
MAIL_FROM=Reseller Platform <onboarding@resend.dev>

PAYMENT_MODE=payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# PayPal checkout uses per-shop Client ID/Secret stored encrypted in the database.
# This is only the fallback VND -> USD rate when a product has no USD price.
PAYPAL_VND_RATE=26000

# USDT Jetton on TON (automatic incoming-transfer scanner)
TONCENTER_API_BASE_URL=https://toncenter.com/api/v3
TONCENTER_API_KEY=
# Official mainnet USDT Jetton master. Do not replace with a user wallet address.
TON_USDT_MASTER_ADDRESS=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
TON_USDT_DECIMALS=6
TON_PAYMENT_SCAN_INTERVAL_MS=30000
# Emergency master switch for every automatic on-chain confirmation scanner.
# Set to false to fail closed without stopping the rest of the worker.
ONCHAIN_AUTO_CONFIRM_ENABLED=false
# Optional; unrelated to normal shop-bot orders. Only used for seller deposits/tier purchases.
PLATFORM_DEPOSIT_SHOP_ID=

# One Alchemy Address Activity webhook for all shop BEP20 receiving wallets.
# Configure the webhook for BNB Chain Mainnet and point it to:
#   POST ${APP_PUBLIC_URL}/api/v1/webhooks/alchemy/bep20
ALCHEMY_NOTIFY_AUTH_TOKEN=
ALCHEMY_BEP20_WEBHOOK_ID=
ALCHEMY_BEP20_SIGNING_KEY=
BSC_WEBHOOK_MIN_CONFIRMATIONS=1
BSC_RPC_URLS=
BSC_USDT_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
BSC_USDT_DECIMALS=18
BSC_MIN_CONFIRMATIONS=15

# Binance Pay Merchant API (auto flow — Phase A)
# Get these from Binance Merchant Admin Portal
# Docs: https://developers.binance.com/docs/binance-pay/authentication
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=
# Webhook URL Binance sẽ gọi khi có PAY_SUCCESS
BINANCE_PAY_WEBHOOK_URL=https://yourdomain.com/api/v1/webhooks/binancepay
# (Optional) Nếu chỉ có 1 shop dùng Binance Pay, set shopId ở đây để bỏ qua DB lookup
BINANCE_PAY_SHOP_ID=
# Rate USDT/VND — dùng để convert VND → USDT khi tạo Binance Pay order
USDT_VND_RATE=26000

DEFAULT_PROVIDER_BASE_URL=https://canboso.com
DEFAULT_PROVIDER_NAME=canboso
DEFAULT_CURRENCY=VND
PUBLIC_UPLOAD_BASE_URL=http://localhost:3000/uploads

SEED_SUPER_ADMIN_EMAIL=thaidem57
SEED_SUPER_ADMIN_PASSWORD=Thaikuku@1
SEED_SELLER_EMAIL=j97shop
SEED_SELLER_PASSWORD=Seller123!
SEED_SELLER_DISPLAY_NAME=J97 SHOP
SEED_SELLER_WALLET_BALANCE=0
SEED_SELLER_BOT_TOKEN=
SEED_SELLER_PROVIDER_KEY=
SEED_DEMO_DATA=false

MOCK_PROVIDER_ENABLED=false
MOCK_TELEGRAM_MODE=false

# TronGrid is used to verify and auto-detect USDT TRC20 payments.
# Production should use a TronGrid API key; the public quota is easily rate-limited (HTTP 429).
TRONGRID_API_BASE_URL=https://api.trongrid.io
TRONGRID_API_KEY=
TRON_USDT_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

CATALOG_SYNC_INTERVAL_MS=60000
CATALOG_SCHEDULER_TICK_MS=5000
CATALOG_SHOPS_REFRESH_MS=60000
CATALOG_SYNC_CONCURRENCY=12
# CATALOG_SYNC_BATCH_SIZE=0
# CATALOG_SYNC_LOCK_TTL_MS=300000
# Central watcher for external inventory. Exact duplicate buyer keys are fetched once and fanned
# out to every matching shop. The global request budget stretches the interval when key count grows.
SOURCE_WATCH_ENABLED=true
SOURCE_WATCH_PROVIDER_NAMES=canboso,shopmmo,roboticvn,zampto,huymai,gigapower
SOURCE_WATCH_TICK_MS=5000
SOURCE_WATCH_TARGET_INTERVAL_MS=5000
SOURCE_WATCH_MAX_REQUESTS_PER_MINUTE=60
# Single-list providers poll conservatively; paginated/N+1 providers use longer minimum cadences.
SOURCE_WATCH_LIGHT_PROVIDER_INTERVAL_MS=15000
SOURCE_WATCH_SHOPMMO_INTERVAL_MS=60000
SOURCE_WATCH_ROBOTICVN_INTERVAL_MS=120000
# Telegram restock fan-out is isolated from catalog/stock synchronization.
RESTOCK_NOTIFICATION_CONCURRENCY=3
# Single-variant checks immediately before checkout. RoboticVN limits requests
# per server IP, shared with full catalog sync and purchase/status calls.
ROBOTICVN_PREFLIGHT_MAX_REQUESTS_PER_MINUTE=15
